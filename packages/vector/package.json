{
  "name": "@zumer/snapdom-vector",
  "version": "1.0.3",
  "description": "Editable SVG and Figma clipboard export for SnapDOM",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "bump:dry": "npx @zumerbox/bump -d",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog",
    "release": "git add package.json CHANGELOG.md ../../package-lock.json && git commit -m \"Bumped vector version\" && git push"
  },
  "main": "./dist/snapdom-vector.mjs",
  "module": "./dist/snapdom-vector.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/snapdom-vector.mjs",
      "default": "./dist/snapdom-vector.mjs"
    },
    "./box-geometry": "./src/emit/box-geometry.js",
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "unpkg": "./dist/snapdom-vector.mjs",
  "jsdelivr": "./dist/snapdom-vector.mjs",
  "files": [
    "dist/",
    "/index.js",
    "/index.d.ts",
    "src/emit/box-geometry.js",
    "README.md",
    "CONTRACT.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "snapdom",
    "snapdom-plugin",
    "dom-capture",
    "svg",
    "figma",
    "vector"
  ],
  "author": "Juan Martin Muda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumerlab/snapdom.git",
    "directory": "packages/vector"
  },
  "bugs": {
    "url": "https://github.com/zumerlab/snapdom/issues"
  },
  "homepage": "https://snapdom.dev/plugins/vector/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tinchox5"
  },
  "peerDependencies": {
    "@zumer/snapdom": "^3.8.1"
  },
  "devDependencies": {
    "@zumer/snapdom": "file:../.."
  },
  "sideEffects": false
}
