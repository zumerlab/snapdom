{
  "name": "@zumer/snapdom-plugins",
  "version": "5.0.0",
  "description": "Official plugin toolbox for SnapDOM: prepare, export and record captures",
  "type": "module",
  "scripts": {
    "bump:dry": "npx @zumerbox/bump -d",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog"
  },
  "exports": {
    ".": "./index.js",
    "./timestamp-overlay": "./timestamp-overlay.js",
    "./ascii-export": "./ascii-export.js",
    "./replace-text": "./replace-text.js",
    "./redact-inputs": "./redact-inputs.js",
    "./filter": "./filter.js",
    "./color-tint": "./color-tint.js",
    "./agent-map": "./agent-map.js",
    "./context-export": "./context-export.js",
    "./html-export": "./html-export.js",
    "./gif-export": "./gif-export.js",
    "./video-export": "./video-export.js"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "types": "./index.d.ts",
  "keywords": [
    "snapdom",
    "snapdom-plugin",
    "dom-capture",
    "plugins"
  ],
  "author": "Juan Martin Muda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumerlab/snapdom.git",
    "directory": "packages/plugins"
  },
  "bugs": {
    "url": "https://github.com/zumerlab/snapdom/issues"
  },
  "homepage": "https://snapdom.dev/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tinchox5"
  },
  "peerDependencies": {
    "@zumer/snapdom": "^3.4.0"
  },
  "devDependencies": {
    "@zumer/snapdom": "file:../.."
  },
  "sideEffects": false
}
