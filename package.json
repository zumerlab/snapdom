{
  "name": "@zumer/snapdom",
  "version": "3.2.0",
  "description": "SnapDOM is a high-performance engine for capturing, modifying, and converting DOM elements into any format.",
  "type": "module",
  "main": "./dist/snapdom.js",
  "module": "./dist/snapdom.mjs",
  "types": "./types/snapdom.d.ts",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./types/snapdom.d.ts",
      "import": "./dist/snapdom.mjs",
      "default": "./dist/snapdom.mjs"
    },
    "./plugins": {
      "types": "./types/snapdom.d.ts",
      "import": "./dist/snapdom.mjs",
      "default": "./dist/snapdom.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "types/snapdom.d.ts",
    "README.md"
  ],
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "lint": "eslint src __tests__ --ext .js",
    "lint:fix": "eslint src __tests__ --ext .js --fix",
    "test:bundle": "npm run compile && node scripts/verify-legacy-bundle.mjs",
    "test:types": "tsc --noEmit",
    "test": "npm run lint && npm run test:types && npm run test:release-checks && npm run test:bundle && node scripts/vitest.mjs run --browser.headless --reporter=verbose",
    "test:visual": "node scripts/vitest.mjs run __tests__/visual.demos. --browser.headless --reporter=verbose",
    "test:firefox": "BROWSER=firefox node scripts/vitest.mjs run --browser.headless --reporter=verbose",
    "test:webkit": "BROWSER=webkit node scripts/vitest.mjs run --browser.headless --reporter=verbose",
    "test:full": "npm run lint && npm run test:types && npm run test:release-checks && npm run test:bundle && BROWSER=all node scripts/vitest.mjs run --browser.headless --reporter=dot",
    "test:release-checks": "node --test scripts/release-checks.node.mjs scripts/benchmark-statistics.node.mjs",
    "report:cross": "node scripts/cross-report.mjs",
    "test:coverage": "npx vitest run --browser.headless --coverage",
    "test:benchmark": "node scripts/benchmark-stable.mjs",
    "test:benchmark:legacy": "npx vitest bench --browser.headless --watch=false",
    "bench:realpage": "node scripts/realpage-bench.mjs",
    "test:pack": "node scripts/check-pack.mjs",
    "site": "npm run compile && node scripts/serve-site.mjs",
    "bump:dry": "npx @zumerbox/bump -d",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog",
    "prepack": "npm run compile",
    "build": "npm pack",
    "release": "REQUIRE_VISUAL=1 npm run test:full && npm run test:pack && npm run test:benchmark && npm run build && echo \"\\n\u2192 Review CHANGELOG.md, then: npm run release:push\"",
    "release:push": "git add CHANGELOG.md && git commit -m \"Bumped version\" && git push --follow-tags",
    "publish:beta": "npm publish --tag beta",
    "publish:dev": "node scripts/publish-dev.mjs",
    "test:pdf": "node packages/plugins/pdf/test/verify.mjs && node packages/plugins/pdf/test/megacheck.mjs && node packages/plugins/pdf/test/encryptcheck.mjs",
    "test:vector": "node packages/plugins/vector/test/verify-vector.mjs && node packages/plugins/vector/test/verify-h2d.mjs && node packages/plugins/vector/test/verify-plugin.mjs && node packages/plugins/vector/test/verify-mathml.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumerlab/snapdom.git"
  },
  "keywords": [
    "zumerlab",
    "snapDOM",
    "html2canvas",
    "html2canvas alternative",
    "dom-to-image alternative",
    "html-to-image",
    "screenshot",
    "engine",
    "html capture",
    "dom capture",
    "html to image",
    "dom to image",
    "html screenshot",
    "capture element",
    "html snapshot",
    "element screenshot",
    "web capture",
    "snapshot tool",
    "render html",
    "capture dom",
    "web snapshot",
    "html export",
    "dom snapshot",
    "html to png",
    "html to svg"
  ],
  "author": "Juan Martin Muda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zumerlab/snapdom/issues"
  },
  "homepage": "https://snapdom.dev/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tinchox5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/browser": "^3.1.2",
    "@vitest/coverage-v8": "^3.1.2",
    "@zumer/snapdiff": "^0.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "playwright": "1.55.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "pdfjs-dist": "4.10.38"
  },
  "overrides": {
    "vite": "^6"
  }
}
