# Peers are NOT auto-installed. Without this, npm tries to place one top-level
# @zumer/snapdom satisfying every peer range in the tree (@zumer/snapdiff wants >=2.0.0,
# which semver refuses to satisfy with the local 3.0.0-beta.0 prerelease) and either
# fails `npm ci` outright or installs the PUBLISHED v2 from the registry — the exact
# v2-shadowing trap the vitest alias exists for. The workspaces that genuinely need the
# core declare it as a `file:../..` devDependency, which links this very checkout.
legacy-peer-deps=true
